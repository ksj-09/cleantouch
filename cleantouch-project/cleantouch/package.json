{
  "name": "cleantouch-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:sdk",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/api.mjs",
    "build": "tsc --noEmit && vite build",
    "build:sdk": "tsc --noEmit && vite build --config vite.sdk.config.ts",
    "build:all": "npm run build && npm run build:sdk",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
