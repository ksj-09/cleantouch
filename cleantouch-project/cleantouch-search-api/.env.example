PORT=8790
SEARCH_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seller retrieval and visual verification use separate capabilities.
# Set only a model whose Google Search access is enabled for your operator project.
SIMILAR_SEARCH_MODEL=
# Optional existing Cloud Vision WEB_DETECTION service (requires active billing).
# Never put these operator credentials in the desktop or Android app.
GOOGLE_VISION_API_KEY=
VISUAL_SEARCH_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_ORIGINS=http://127.0.0.1:5180
MAX_REQUESTS_PER_MINUTE=30
LIVE_CHAT_CONNECTIONS_PER_MINUTE=8
LIVE_CHAT_DAILY_LIMIT=30

# Deployment-wide ledger. Never use 'off' on a paid public service.
USAGE_GUARD_MODE=required
USAGE_IDENTITY_SECRET=
USAGE_DATABASE_URL=
AI_REQUIRE_SIGNED_REQUESTS=false
AI_PAUSED=false
AI_GLOBAL_DAILY_UNITS=1000
AI_DEVICE_DAILY_UNITS=300
AI_LEGACY_DAILY_UNITS=100
AI_NETWORK_DAILY_UNITS=600
AI_NETWORK_MINUTE_UNITS=100
# Units limit requests, not currency. Live token issuance does not meter session spend.
