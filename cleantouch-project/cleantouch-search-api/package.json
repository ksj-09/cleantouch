{
  "name": "cleantouch-search-api",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check:gemini": "npm run build && node --env-file-if-exists=.env scripts/check-gemini.mjs",
    "pilot:catalogue": "npm run build && node scripts/catalogue-pilot.mjs",
    "catalogue:check": "npm run build && node scripts/check-catalogue.mjs",
    "catalogue:evaluate": "npm run build && node scripts/evaluate-catalogue.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@netlify/database": "^2.0.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "jpeg-js": "^0.4.4",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
