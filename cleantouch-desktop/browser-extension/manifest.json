{
  "manifest_version": 3,
  "name": "CleanTouch 영상 시간 연결",
  "description": "YouTube와 Instagram의 실제 영상 재생 시간을 이 PC의 CleanTouch에 전달합니다. 영상이나 이미지를 외부 서버에 보내지 않습니다.",
  "version": "0.1.0",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "video-reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
