{
  "name": "cleantouch-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "CleanTouch Windows screen product finder",
  "main": "main.cjs",
  "scripts": {
    "build:provider": "npm --prefix ../cleantouch-search-api run build && node scripts/copy-provider.cjs",
    "prestart": "npm run build:provider",
    "start": "electron .",
    "test:smoke": "node test/smoke.mjs",
    "predist:win": "npm run build:provider",
    "dist:win": "electron-builder --win portable nsis --x64"
  },
  "build": {
    "appId": "kr.cleantouch.desktop",
    "productName": "CleanTouch",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "index.html", "renderer.js", "styles.css", "icon.ico", "vendor/**/*", "package.json"],
    "win": { "target": ["portable", "nsis"], "icon": "icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12"
  }
}
