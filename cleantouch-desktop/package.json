{
  "name": "cleantouch-desktop",
  "version": "0.1.41",
  "private": true,
  "description": "CleanTouch Windows screen product finder",
  "author": "CleanTouch",
  "main": "main.cjs",
  "scripts": {
    "build:provider": "npm --prefix ../cleantouch-search-api run build && node scripts/copy-provider.cjs",
    "prestart": "npm run stage:segmentation && npm run stage:ai && npm run stage:ocr",
    "stage:segmentation": "node scripts/copy-segmentation-assets.cjs",
    "stage:ai": "node scripts/stage-product-ai.cjs",
    "start": "electron .",
    "test:smoke": "node test/smoke.mjs",
    "predist:win": "npm run stage:segmentation && npm run stage:ai && npm run stage:ocr",
    "dist:win": "electron-builder --win portable nsis --x64 --publish never",
    "test:updates": "node --test test/updater.test.cjs",
    "pretest:unit": "node scripts/stage-timeline.cjs",
    "test:unit": "node --test test/*.test.cjs",
    "stage:ocr": "node scripts/stage-screen-ocr.cjs"
  },
  "build": {
    "appId": "kr.cleantouch.desktop",
    "productName": "CleanTouch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "place-chat.js",
      "chat-store.cjs",
      "chat-memory.js",
      "shopping-cards.js",
      "capture-consent.cjs",
      "share-permission.js",
      "tutorial.js",
      "chat-endpoint.json",
      "index.html",
      "renderer.js",
      "product-identity.js",
      "ai-categories.js",
      "ai-label-worker.js",
      "styles.css",
      "icon.ico",
      "vendor/**/*",
      "package.json",
      "updater.cjs",
      "update-ui.js",
      "watch-timeline.js",
      "screen-watch.js",
      "windows-media-time.cjs",
      "windows-media-time.ps1",
      "glow-regions.js",
      "scene-capture.js",
      "windows-video-region.cjs",
      "windows-video-region.ps1",
      "image-import.cjs",
      "candidate-policy.js",
      "object-regions.js",
      "live-screen.js",
      "recent-scenes.js",
      "media-evidence.cjs",
      "safe-logging.cjs",
      "service-client.cjs",
      "!vendor/gemini-provider.js",
      "!vendor/provider-errors.js",
      "!vendor/rate-limit.js",
      "image-encoding.js",
      "chat-title.js",
      "chat-title-service.cjs",
      "conversation-context.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ksj-09",
        "repo": "cleantouch",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "1.0.1",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "js-yaml": "5.4.2",
    "tesseract.js": "^7.0.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
